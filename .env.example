# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored and never committed. config.json only references the
# variable NAMES (e.g. "env:ZHIPU_API_KEY"), so no secret ever lands in git.
#
# Only set the keys for the providers you actually use.

# Zhipu GLM (profile: glm-api)
ZHIPU_API_KEY=

# Moonshot Kimi (profile: kimi-api)
MOONSHOT_API_KEY=

# Optional: default model profile without passing -m each time
# REPO_WIKI_MODEL=ollama-qwen
